<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vibeprompt.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/vibe-prompt/.venv/bin/uvicorn</string>
        <string>vibe_prompt.main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8420</string>
        <string>--workers</string>
        <string>1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USER/vibe-prompt/server</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USER/Library/Logs/vibe-prompt/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USER/Library/Logs/vibe-prompt/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/USER/vibe-prompt/server/src</string>
    </dict>
</dict>
</plist>
